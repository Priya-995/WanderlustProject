<!-- Script -->
<script>
document.addEventListener('DOMContentLoaded', function() {
  
  // ===== Mobile Menu Toggle =====
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  
  if (mobileMenuBtn && mobileMenu && menuIcon) {
    mobileMenuBtn.addEventListener('click', function() {
      
      
      // Toggle icon between bars and X
      if (mobileMenu.classList.contains('hidden')) {
        menuIcon.classList.remove('fa-times');
        menuIcon.classList.add('fa-bars');
      } else {
        menuIcon.classList.remove('fa-bars');
        menuIcon.classList.add('fa-times');
      }
    });
  }

  // ===== Desktop User Menu Dropdown =====
  const userMenu = document.getElementById('user-menu');
  const dropdownMenu = document.getElementById('dropdown-menu');
  
  if (userMenu && dropdownMenu) {
    userMenu.addEventListener('click', function(e) {
      e.stopPropagation();
      dropdownMenu.classList.toggle('hidden');
    });
    
    // Close dropdown when clicking outside
    document.addEventListener('click', function(e) {
      if (!userMenu.contains(e.target)) {
        dropdownMenu.classList.add('hidden');
      }
    });
  }

  // ===== Desktop Search =====
  const desktopSearchInput = document.getElementById('desktop-search-input');
  const desktopClearBtn = document.getElementById('desktop-clear-btn');

  if (desktopSearchInput && desktopClearBtn) {
    desktopSearchInput.addEventListener('input', function() {
      desktopClearBtn.classList.toggle('hidden', !this.value);
    });
    
    desktopClearBtn.addEventListener('click', function() {
      desktopSearchInput.value = '';
      desktopClearBtn.classList.add('hidden');
      desktopSearchInput.focus();
    });
  }

  // ===== Mobile Search =====
  const mobileSearchInput = document.getElementById('mobile-search-input');
  const mobileClearBtn = document.getElementById('mobile-clear-btn');

  if (mobileSearchInput && mobileClearBtn) {
    mobileSearchInput.addEventListener('input', function() {
      mobileClearBtn.classList.toggle('hidden', !this.value);
    });
    
    mobileClearBtn.addEventListener('click', function() {
      mobileSearchInput.value = '';
      mobileClearBtn.classList.add('hidden');
      mobileSearchInput.focus();
    });
  }

  // ===== Preserve search query from URL =====
  const urlParams = new URLSearchParams(window.location.search);
  const searchQuery = urlParams.get('search');
  
  if (searchQuery) {
    if (desktopSearchInput) {
      desktopSearchInput.value = searchQuery;
      if (desktopClearBtn) desktopClearBtn.classList.remove('hidden');
    }
    if (mobileSearchInput) {
      mobileSearchInput.value = searchQuery;
      if (mobileClearBtn) mobileClearBtn.classList.remove('hidden');
    }
  }

  // ===== Close mobile menu on window resize to desktop =====
  window.addEventListener('resize', function() {
    if (window.innerWidth >= 1024 && mobileMenu) {
      mobileMenu.classList.add('hidden');
      if (menuIcon) {
        menuIcon.classList.remove('fa-times');
        menuIcon.classList.add('fa-bars');
      }
    }
  });

});
</script>
